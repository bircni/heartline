# Local development defaults (no secrets). Override in apps/server/.env, which is git-ignored.
CONFIG_PATH=../../dev/status.yaml
PLUGINS_DIR=../../plugins
DATABASE_URL=sqlite:../../dev/data/status.db
# The Vite dev server proxies /api, /mcp and /.well-known to this server.
BASE_URL=http://localhost:5173
PORT=3000
